  "authority_cn": "10_document.json决定当前六区、原点位、路线与语义；depth_supplement决定本轮已有高差/地下层与新增地形路径。源elevation_value为灰度参考，不是米。分镜、辅助色与资产造型属于美术建议。",
  "reference_rules_cn": [
    "参考1使用造型与配色语汇，参考2使用手绘构图与气氛；不复刻建筑、城堡、IP角色、标识、签名或文字。",
    "用户已排除商业Mushroom包，不推荐搜索/采购；原创酵母生态仍服从当前JSON内容。",
    "不采用旧版麦谷/大烤原命名或布局。",
    "当前先做整体AI预览统一方向，再做六区场景概念图，再拆资产与搭建；文档本身不触发UE修改或机制实现。"
  ],
  "global_overview": {
    "name_cn": "五个地表区域与一个地下层的整体气氛预览",
    "composition_cn": "主画面保持500×500m的相对拓扑：中央基地嵌在浅层环带，左侧/西北为发酵隆起，左上为酵母高地，右侧为霉菌塌陷低地。地下菌核以单独下方剖面/附属画幅表示层级，不能画为地表右上的露天Boss盆地。",
    "must_read_cn": [
      "基地在浅层内部，而非六座并排小岛。",
      "黄油瀑布从发酵崖顶经潭溪流到破壁口，水系连续。",
      "发酵—浅层与发酵—酵母各只有规定通口；霉菌桥为可选近道并有外圈路。",
      "深渊主动入口与地下菌核房有层级连接，区别于坍塌陷阱。"
    ],
    "render_language_cn": "原创手绘环境概念图、可见绘画笔触、较大清楚色块、受光与阴影层次、有机圆润面团形体，避免工程UI/网格/坐标文字和水印；概念阶段颜色允许在源色基础上做和谐调整。",
    "not_to_claim_cn": "AI概念图不是严格米制平面图，不证明碰撞、导航、材质或机制已实现。源点位和路线约束由本简报保留，进入UE阶段再按实际相机验证。"
  },
  "asset_strategy": {
    "fantastic_root": "/Game/Maps/DoughWorldDepth/Village/Meshes/",
    "reuse_scope_cn": "优先复用当前已采用的Fantastic桌架、木箱、独立盖、面包、袋筐、生活木器、小车、散板和桥面。保留原包材质/纹理依赖；不把完整住宅设为面团世界主轮廓。",
    "custom_priority_cn": [
      "统一面团地表/崖面/弧顶模块",
      "黄油瀑布三段水系与孔洞家族",
      "原创酵母囊与面筋植被",
      "腐败与地下内腔模块",
      "核心祭坛、菌核、角色与资源专用造型"
    ],
    "non_fantastic_existing_cn": "当前SoStylized岩石与低草可作为地形底层或远景辅助；不因本概念任务重新导入、重刷植被或购买资源。"
  },
  "precision_notes_cn": [
    "pressure_plate mech_plate_1在当前两JSON中为(393.3,180)，与既有桥体中心(393.3,170)区分；本概念阶段不移动二者。",
    "demo_route第2面粉(210,343.3)与resources/flour_demo(200,233.3)是不同原记录，不合并。",
    "所有art_reference_pins仅为意向与材质参考，不据其坐标放真实地标。",
    "地下arena_bounds_reference.activity_envelope_m=[80,60]是设计活动范围，不把区域radius当Boss房直径。"
  ],
