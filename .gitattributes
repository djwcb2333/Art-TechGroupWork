# Preserve current file bytes, including line endings, when creating this baseline.
# Text files still have ordinary Git diffs; -text disables line-ending conversion.
* -text

# Unreal packages and binary/source art use Git LFS before the first commit.
# No lockable attribute: this setup must not make existing assets read-only.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
